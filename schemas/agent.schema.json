{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openconductor.dev/schemas/v1alpha1/agent.json",
  "title": "OpenConductor Agent Manifest",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "openconductor.dev/v1alpha1" },
    "kind": { "const": "Agent" },
    "metadata": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" }, "name": { "type": "string", "minLength": 2 } }, "additionalProperties": true },
    "spec": { "type": "object", "required": ["objective", "skills", "handoff", "evaluation"], "properties": { "objective": { "type": "string", "minLength": 12 }, "execution": { "type": "object", "properties": { "provider": { "type": "string" }, "model": { "type": "string" } } }, "skills": { "type": "object", "required": ["allow"], "properties": { "allow": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } } }, "handoff": { "type": "object", "required": ["accepts", "produces"], "properties": { "accepts": { "type": "array", "items": { "type": "string" } }, "produces": { "type": "array", "items": { "type": "string" } } } }, "evaluation": { "type": "object", "required": ["cases"], "properties": { "cases": { "type": "array", "minItems": 1, "items": { "type": "string" } } } } }, "additionalProperties": true }
  },
  "additionalProperties": false
}
