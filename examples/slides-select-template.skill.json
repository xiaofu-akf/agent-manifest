{
  "apiVersion": "openconductor.dev/v1alpha1",
  "kind": "Skill",
  "metadata": { "id": "slides.select-template", "name": "Select a presentation template" },
  "spec": {
    "description": "Rank approved slide templates against a structured project brief and license constraints.",
    "input": { "type": "object", "required": ["brief"] },
    "output": { "type": "object", "required": ["candidates"] },
    "permissions": { "risk": "none", "externalNetwork": false, "filesystem": false, "approvalRequired": false }
  }
}
