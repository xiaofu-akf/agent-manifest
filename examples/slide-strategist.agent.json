{
  "apiVersion": "openconductor.dev/v1alpha1",
  "kind": "Agent",
  "metadata": { "id": "slide-strategist", "name": "Slide Strategist" },
  "spec": {
    "execution": { "provider": "user-configured", "model": "user-selected" },
    "objective": "Turn an approved brief into a coherent, audience-aware slide narrative.",
    "skills": { "allow": ["slides.select-template", "slides.compose"] },
    "handoff": { "accepts": ["brief"], "produces": ["storyboard", "template-requirements"] },
    "evaluation": { "cases": ["pitch-deck-basic"] }
  }
}
